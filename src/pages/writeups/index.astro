---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('writeups',({data})=>data.published)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Writing — Zakaria Adili"><div class="shell"><section class="section archive"><p class="eyebrow">/writing</p><h1 class="page-title">field notes<span class="cursor">_</span></h1><p class="subtle">Notes from authorized labs. Some guided, some independent. Always documented.</p><label class="search-label" for="search">filter entries</label><input id="search" type="search" placeholder="search..." aria-label="Search write-ups"/><div class="entries">{posts.map(post=><a class="entry" data-keywords={(post.data.title+' '+post.data.platform+' '+post.data.tags.join(' ')+' '+post.data.summary).toLowerCase()} href={'/writeups/'+post.id+'/'}><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time><span class="entry-title">{post.data.title}</span><span class="entry-type">{post.data.status.toLowerCase()}</span><span class="entry-arrow">↗</span></a>)}</div><p id="empty" hidden>No matching entries.</p></section></div><script>const input=document.querySelector<HTMLInputElement>('#search');const cards=[...document.querySelectorAll<HTMLElement>('.entry')];const empty=document.querySelector<HTMLElement>('#empty');input?.addEventListener('input',()=>{const term=input.value.trim().toLowerCase();let visible=0;cards.forEach(card=>{const match=(card.dataset.keywords||'').includes(term);card.hidden=!match;if(match)visible++});if(empty)empty.hidden=visible>0});</script></Base>
---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('writeups',({data})=>data.published)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Write-ups | Zakaria Adili"><div class="shell"><section class="section"><p class="eyebrow">// TECHNICAL JOURNAL</p><h1 class="page-title">The write-up archive<span class="green">.</span></h1><p class="muted">Enumeration, exploitation, privilege escalation and lessons from authorized labs.</p><input id="search" type="search" placeholder="Search machines, platforms, techniques…" aria-label="Search write-ups"/><div id="entries" class="cards">{posts.map(post=><a class="card entry" data-keywords={(post.data.title+' '+post.data.platform+' '+post.data.tags.join(' ')+' '+post.data.summary).toLowerCase()} href={'/writeups/'+post.id}><div class="tags">{post.data.platform} · {post.data.difficulty} · {post.data.status}</div><h3>{post.data.title}</h3><p>{post.data.summary}</p><span class="green">READ ↗</span></a>)}</div><p id="empty" hidden>No matching write-ups.</p></section></div><script>const input=document.querySelector<HTMLInputElement>('#search');const cards=[...document.querySelectorAll<HTMLElement>('.entry')];const empty=document.querySelector<HTMLElement>('#empty');input?.addEventListener('input',()=>{const term=input.value.trim().toLowerCase();let visible=0;cards.forEach(card=>{const match=(card.dataset.keywords||'').includes(term);card.hidden=!match;if(match)visible++});if(empty)empty.hidden=visible>0});</script></Base>
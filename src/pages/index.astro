---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('writeups', ({data}) => data.published)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base>
<div class="shell">
  <section class="intro">
    <p class="eyebrow">/home/zakaria</p>
    <h1>Zakaria Adili<span class="cursor">_</span></h1>
    <p class="identity">DEV11 / offensive security</p>
    <p class="description">Learning to break systems. Trying to understand them better.<br/>Notes from labs, things that worked, things that didn't.</p>
    <p class="subtle">Currently studying for the OSCP.</p>
  </section>
  <section class="section" id="writing">
    <div class="section-heading"><h2>writing</h2><span>{String(posts.length).padStart(2,'0')} entries</span></div>
    <div class="entries">{posts.slice(0,6).map(post => <a class="entry" href={'/writeups/'+post.id}><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time><span class="entry-title">{post.data.title}</span><span class="entry-type">{post.data.platform.toLowerCase()} / {post.data.status.toLowerCase()}</span><span class="entry-arrow">↗</span></a>)}</div>
    <a class="underlink" href="/writeups">all write-ups →</a>
  </section>
  <section class="section about" id="about">
    <div class="section-heading"><h2>about</h2></div>
    <p>I'm Zakaria. I spend my time learning penetration testing, working through labs, and writing down what I actually understand. This is a record of that process, not a highlight reel.</p>
    <p>Mostly Linux, web security, enumeration, and privilege escalation. More to come.</p>
  </section>
  <section class="section" id="contact"><div class="section-heading"><h2>elsewhere</h2></div><a class="underlink" href="https://github.com/zakadili" target="_blank" rel="noopener noreferrer">github ↗</a></section>
</div>
</Base>
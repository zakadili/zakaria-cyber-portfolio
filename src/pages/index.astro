---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('writeups',({data})=>data.published)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="DEV11 — Zakaria Adili | Offensive Security">
<section class="hero" id="top">
 <div class="hero-grid" aria-hidden="true"></div>
 <div class="hero-copy">
  <p class="eyebrow">[ CYBERSECURITY / RED TEAM / OFFENSIVE SECURITY ]</p>
  <h1><span>ZAKARIA</span><strong>ADILI<span class="red">/</span></strong></h1>
  <p class="role"><span class="red">&gt;_</span> DEV11 — OFFENSIVE SECURITY</p>
  <p class="hero-desc">Learning offensive security through hands-on labs, careful research, and documented failures as well as wins.</p>
  <div class="actions"><a class="action-primary" href="#projects">EXPLORE WORK <span>↗</span></a><a class="action-secondary" href="/writeups">READ WRITE-UPS ↗</a></div>
 </div>
 <div class="hero-side"><span>01 / ENTRY POINT</span><span>OSCP / IN PROGRESS</span><span>AUTHORIZED LABS ONLY</span></div>
 <div class="hero-foot"><span>DEV11 // PERSONAL SECURITY JOURNAL</span><a href="#transition">SCROLL TO ENTER <span class="red">↓</span></a></div>
</section>
<section class="zoom-sequence" id="transition" aria-label="DEV11 interactive scroll experience">
 <div class="zoom-sticky">
  <div class="terminal-atmosphere" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="ambient-glow"></div></div>
  <div class="terminal-scene">
   <div class="terminal-window" aria-label="Illustrative DEV11 terminal">
    <div class="terminal-bar"><div class="terminal-lights"><i></i><i></i><i></i></div><span>dev11@lab: ~/field-notes</span><span>— □ ×</span></div>
    <div class="terminal-body" id="terminal-body">
      <div id="terminal-result" class="terminal-result" aria-live="off"></div>
      <div class="terminal-active-line" id="terminal-active-line"><span class="terminal-host">dev11@lab</span>:~$ <span id="terminal-typed"></span><span class="terminal-caret">▌</span></div>
      <form class="terminal-form" id="terminal-form" autocomplete="off" hidden>
        <label for="terminal-command">dev11@lab:~$</label>
        <input id="terminal-command" name="command" aria-label="Terminal command" spellcheck="false" maxlength="40" placeholder="type help..." />
        <button type="submit">RUN ↵</button>
      </form>
    </div>
    <div class="terminal-bottom"><span>SESSION / 001</span><span>LEARN • TEST • DOCUMENT</span></div>
   </div>
  </div>
  <div class="scene-caption"><span>02 / INSIDE THE SYSTEM</span><h2>EVERY<br/>LAYER <em>MATTERS.</em></h2><p>Enumeration. Understanding. Persistence in learning.<br/>Scroll to inspect the workspace.</p></div>
  <div class="scene-progress"><span>SCROLL TO EXPLORE</span><div class="progress-track"><div class="progress-fill"></div></div><span>DEV11 / 02</span></div>
 </div>
</section>
<section class="projects" id="projects">
 <div class="section-top"><span>03 / FIELD WORK</span><span>LAB NOTES & LEARNING</span></div>
 <div class="section-title"><h2>THE<br/><em>ARCHIVE.</em></h2><p>Write-ups from authorized training environments. Methodology, mistakes, and what I learned along the way.</p></div>
 <div class="project-list">{posts.length ? posts.slice(0,6).map((post,i)=><a class="project-row" href={'/writeups/'+post.id+'/'}><span class="project-index">{String(i+1).padStart(2,'0')}</span><div><span class="project-category">{post.data.platform} / {post.data.status}</span><h3>{post.data.title}</h3><p>{post.data.summary}</p></div><span class="project-link">↗</span></a>) : <p class="empty-note">Field notes coming soon.</p>}</div>
 <a class="all-link" href="/writeups">OPEN THE FULL ARCHIVE ↗</a>
</section>
<section class="focus-section" id="about"><div class="section-top"><span>04 / ABOUT</span><span>THE PERSON BEHIND DEV11</span></div><div class="focus-grid"><h2>NO SHORTCUTS.<br/><em>JUST WORK.</em></h2><div><p>I'm Zakaria Adili. I’m building my skills in penetration testing, Linux, web security, Active Directory, and privilege escalation. This site tracks the process as it happens.</p><div class="focus-lines"><span>01 — OSCP PREPARATION</span><span>02 — HANDS-ON LABS</span><span>03 — TECHNICAL WRITE-UPS</span></div></div></div></section>
<section class="resume-section" id="resume">
 <div class="section-top"><span>05 / BACKGROUND</span><span>CURRICULUM VITAE</span></div>
 <div class="resume-intro"><h2>BEFORE<br/><em>THE SHELL.</em></h2><p>My route into cybersecurity hasn't been linear. Investigations, language data, business, and software development all shaped how I approach problems today.</p></div>
 <div class="resume-columns"><div><h3>EXPERIENCE</h3>
  <article class="resume-item"><time>2020 — 2022</time><div><h4>Amazon</h4><strong>Investigations Specialist · Prague</strong><p>Investigated fraud patterns and risks involving seller onboarding, identity verification, KYC checks, and compliance procedures.</p></div></article>
  <article class="resume-item"><time>2019</time><div><h4>TransPerfect</h4><strong>Language Data Analyst · Prague</strong><p>French-language data analysis, transcription, and linguistic modeling for virtual assistant development.</p></div></article>
  <article class="resume-item"><time>2012 — 2014</time><div><h4>Jnane Souissi Book Club</h4><strong>President & Co-founder · Morocco</strong><p>Organized reading events, school competitions, partnerships, and sponsorship outreach.</p></div></article>
  <details class="resume-more"><summary>EARLIER INTERNSHIPS +</summary><p>JACOBS Engineering S.A. — HR Intern (2014)<br/>Palmeraie Hotels & Resorts — Project Intern (2013)</p></details>
 </div><div><h3>EDUCATION</h3>
  <article class="resume-item"><time>2022 — 2025</time><div><h4>EU Business School</h4><strong>Master's studies · Digital Business</strong></div></article>
  <article class="resume-item"><time>2022</time><div><h4>Le Wagon</h4><strong>Full-Stack Web Development / Data Science</strong></div></article>
  <article class="resume-item"><time>2017 — 2020</time><div><h4>University of New York in Prague</h4><strong>Bachelor's · Business Administration</strong></div></article>
  <article class="resume-item"><time>2016 — 2017</time><div><h4>Anglo-American University, Prague</h4><strong>Exchange Program · Business Administration</strong></div></article>
  <article class="resume-item resume-highlight"><time>2014 — 2016</time><div><h4>Al Akhawayn University</h4><strong>University studies · Morocco</strong></div></article>
  <h3 class="resume-language-title">LANGUAGES</h3><p class="resume-languages">Arabic / Native<br/>French / Native or bilingual<br/>English / Full professional<br/>Spanish / Working proficiency</p>
 </div></div>
 <div class="resume-links"><a href="https://www.linkedin.com/in/zakaria-adili-405975123/" target="_blank" rel="noopener noreferrer">LINKEDIN ↗</a><a href="mailto:adilizakaria1@gmail.com">EMAIL ME ↗</a></div>
</section>
<section class="contact-section" id="contact"><span>06 / OUTSIDE THE SYSTEM</span><h2>STAY<br/><em>CURIOUS.</em></h2><a href="https://github.com/zakadili" target="_blank" rel="noopener noreferrer">FIND ME ON GITHUB ↗</a></section>
<script>
 const zone=document.querySelector<HTMLElement>('.zoom-sequence');
 const sticky=document.querySelector<HTMLElement>('.zoom-sticky');
 const reduce=window.matchMedia('(prefers-reduced-motion: reduce)');
 let queued=false;
 function update(){queued=false;if(!zone||!sticky)return;const r=zone.getBoundingClientRect();const total=Math.max(1,zone.offsetHeight-window.innerHeight);const p=Math.max(0,Math.min(1,-r.top/total));const animated=!reduce.matches;sticky.style.setProperty('--terminal-scale',String(animated?.70+p*.72:1));sticky.style.setProperty('--terminal-rotate',String(animated?(-11+p*11):0)+'deg');sticky.style.setProperty('--terminal-shift',String(animated?(12-p*12):0)+'vh');sticky.style.setProperty('--terminal-opacity',String(animated?Math.min(1,.45+p*2.8):1));sticky.style.setProperty('--caption-opacity',String(animated?Math.max(.16,1-p*1.35):1));sticky.style.setProperty('--scene-progress',String(p*100)+'%');}
 function onScroll(){if(!queued){queued=true;requestAnimationFrame(update)}}
 window.addEventListener('scroll',onScroll,{passive:true});window.addEventListener('resize',onScroll);reduce.addEventListener('change',onScroll);update();
</script>
<script>
const form=document.querySelector<HTMLFormElement>('#terminal-form');
const input=document.querySelector<HTMLInputElement>('#terminal-command');
const output=document.querySelector<HTMLElement>('#terminal-result');
const responses:Record<string,string>={
help:'COMMANDS: whoami | experience | education | languages | skills | status | contact | clear',
whoami:'Zakaria Adili / DEV11 — offensive security student. Background in fraud investigations, data analysis and software development.',
experience:'Amazon — Investigations Specialist (2020–2022)\\nTransPerfect — Language Data Analyst (2019)\\nJnane Souissi Book Club — President & Co-founder (2012–2014)\\nEarlier: JACOBS and Palmeraie Hotels.\\nSee the CV section below.',
education:'EU Business School — Digital Business (2022–2025)\\nLe Wagon — Full-Stack / Data Science (2022)\\nUniversity of New York in Prague — Business Administration (2017–2020)\\nAl Akhawayn University — Studies (2014–2016)\\nAnglo-American University, Prague — Exchange Program (2016–2017).',
languages:'Arabic: native\\nFrench: native/bilingual\\nEnglish: full professional\\nSpanish: working proficiency',
skills:'Currently studying: web security, Linux privilege escalation, Active Directory, enumeration and penetration testing.',
status:'OSCP preparation: IN PROGRESS. No certification claimed.',
contact:'Email: adilizakaria1@gmail.com\\nLinkedIn: linkedin.com/in/zakaria-adili-405975123'
};
const typed=document.querySelector<HTMLElement>('#terminal-typed');
const activeLine=document.querySelector<HTMLElement>('#terminal-active-line');
const terminalBody=document.querySelector<HTMLElement>('#terminal-body');
function runCommand(command:string){
 if(!output)return;
 if(command==='clear'){output.textContent='';return;}
 const line=document.createElement('div');line.className='terminal-response';
 const heading=document.createElement('strong');heading.textContent='dev11@lab:~$ '+command;
 const body=document.createElement('pre');body.textContent=(responses[command]??'Command not found. Type help for available commands.').replaceAll('\\n',String.fromCharCode(10));
 line.append(heading,body);output.append(line);
 terminalBody?.scrollTo({top:terminalBody.scrollHeight,behavior:'instant'});
}
form?.addEventListener('submit',(event)=>{
 event.preventDefault();if(!input)return;
 const command=input.value.trim().toLowerCase();if(!command)return;
 runCommand(command);input.value='';
});
const demoCommands=['whoami','experience','education','languages','skills','status','contact'];
let autoStarted=false;
let autoTimer:number|undefined;
function startAuto(){
 if(autoStarted||!typed||!activeLine||!form)return;
 autoStarted=true;
 const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 if(reduced){
  for(const command of demoCommands)runCommand(command);
  activeLine.hidden=true;form.hidden=false;return;
 }
 let commandIndex=0;let charIndex=0;
 function tick(){
  if(commandIndex>=demoCommands.length){
   activeLine.hidden=true;form.hidden=false;return;
  }
  const command=demoCommands[commandIndex];
  if(charIndex<command.length){
   typed.textContent=command.slice(0,++charIndex);
   autoTimer=window.setTimeout(tick,135);
  }else{
   autoTimer=window.setTimeout(()=>{
    runCommand(command);
    typed.textContent='';charIndex=0;commandIndex++;
    autoTimer=window.setTimeout(tick,1300);
   },500);
  }
 }
 autoTimer=window.setTimeout(tick,350);
}
const scene=document.querySelector('.zoom-sequence');
if(scene&&'IntersectionObserver' in window){
 const observer=new IntersectionObserver(entries=>{
  if(entries.some(entry=>entry.isIntersecting)){observer.disconnect();startAuto();}
 },{threshold:.15});
 observer.observe(scene);
}else{startAuto();}
</script>
</Base>